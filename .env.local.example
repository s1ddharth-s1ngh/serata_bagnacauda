# Copia in .env.local: serve solo in locale (npm run dev, npm run download-all).
# Il sito pubblico (GitHub Pages) prende i valori pubblici da .github/workflows/pages.yml.

# Supabase > Project Settings > API (pubbliche: finiscono nel browser, va bene)
NEXT_PUBLIC_SUPABASE_URL=https://ceibiojkadggtwolnaab.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Base del QR del /wall ($NEXT_PUBLIC_SITE_URL/upload), senza slash finale.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOLO locale (mai NEXT_PUBLIC_): usata da scripts/download-all.ts
# Secret key (sb_secret_...) oppure legacy service_role, da Supabase > Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=

# La password di /admin NON sta qui: è il secret ADMIN_PASSWORD della Edge Function "admin"
# (Supabase > Edge Functions > Secrets).
