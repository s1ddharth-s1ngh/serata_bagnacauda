# Copia in .env.local (locale) e imposta le stesse variabili su Vercel.

# Supabase > Project Settings > API (pubbliche: finiscono nel browser, va bene)
NEXT_PUBLIC_SUPABASE_URL=https://ceibiojkadggtwolnaab.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pubblico del sito, senza slash finale: il QR del /wall punta a $NEXT_PUBLIC_SITE_URL/upload.
# Viene incorporato al build: dopo averlo cambiato su Vercel serve un nuovo deploy.
NEXT_PUBLIC_SITE_URL=https://tuo-progetto.vercel.app

# SOLO server (mai NEXT_PUBLIC_): usate da /api/admin e da scripts/download-all.ts
# Secret key (sb_secret_...) oppure legacy service_role, da Supabase > Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
